{
  "name": "universal-video-engine",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @uve/web",
    "build": "npm run typecheck:core && npm run build --workspace @uve/web",
